*/node_modules/
.pnp/
.pnp.js

# 2. Python & Virtual Environments
__pycache__/
*/__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
.venv/
env.bak/
venv.bak/
pip-log.txt
pip-delete-this-directory.txt

# 3. SQLite & Local Database Files
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
relayai.db*

# 4. Environment Variables & Secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env*.local
*.pem
*.key
*.cert
*.crt
