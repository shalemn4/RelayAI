dist/
*/dist/
build/
*/build/
out/
.turbo/
*.tsbuildinfo

# 7. Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# 8. Testing & Code Coverage
.pytest_cache/
*/.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage/
*/coverage/
.nyc_output/

# 9. Operating System & Editor Files
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
desktop.ini

# IDE & Editor configs
